                                    <?php
                                       
                                            $sql1="SELECT 
                                                        V.districtid, 
                                                        D.district_name, 
                                                        COUNT(V.id) AS count 
                                                    FROM 
                                                        vacancy_edit_details AS V
                                                    JOIN 
                                                        districts AS D ON V.districtid = D.id
                                                    JOIN 
                                                        new_vacancy AS nv ON V.centerid = nv.id
                                                    WHERE 
                                                        (V.approved_by IS NULL OR V.approved_by = '') 
                                                        AND nv.updated_status = 'R'  
                                                    GROUP BY 
                                                        V.districtid, D.district_name;
                                                    ";
                                            $res1=execute_query($sql1);
                                            $i=1;
                                            while($row=mysqli_fetch_assoc($res1)){
                                              
                                                echo'<tr>
                                                        <td>'.$i++.'</td>
                                                        <td>'.$row['district_name'].'</td>
                                                        <td><div class="badge badge-pill badge-primary">'.$row['count'].'</div></td>
                                                        <td><a href="requestreceived_details.php?distid='.$row['districtid'].'">View</a></td>
                                                       
                                                    </tr>';

                                            }
                                            
                                            
                                        ?>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                    </div>
                </div>
