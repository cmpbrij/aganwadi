      max-height: 340px;
      overflow:auto;
      font-size: 11.5px;
      line-height: 1.35;
      white-space: pre-wrap;
      word-break: break-word;
      font-family: var(--mono);
    }

    .jsonTools{
      display:flex;
      gap:8px;
      align-items:center;
      flex-wrap:wrap;
    }

    .mono{ font-family: var(--mono); }

    .footNote{
      margin-top: 10px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.35;
    }

    .sectionHint{
      display:flex;
      gap:10px;
      align-items:center;
      flex-wrap:wrap;
      margin-top: 8px;
    }
    .hintPill{
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      padding: 6px 10px;
      font-size: 12px;
      color: #334155;
      font-weight: 800;
    }

    .danger{
